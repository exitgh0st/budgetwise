generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String        @id @default(uuid())
  name               String
  type               AccountType
  balance            Decimal       @default(0) @db.Decimal(12, 2)
  maintainingBalance Decimal?      @db.Decimal(12, 2)
  providerId         String?
  userId             String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  transactions       Transaction[]  @relation("TransactionAccount")
  outgoingTransfers  Transaction[]  @relation("TransferFromAccount")
  incomingTransfers  Transaction[]  @relation("TransferToAccount")
  scheduledTransactions ScheduledTransaction[]
  goals              Goal[]

  @@index([userId])
}

model Category {
  id           String        @id @default(uuid())
  name         String
  icon         String?
  isSystem     Boolean       @default(false)
  userId       String?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  budgets      Budget[]
  scheduledTransactions ScheduledTransaction[]

  @@unique([name, userId])
  @@index([userId])
}

model Transaction {
  id            String          @id @default(uuid())
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  description   String?
  date          DateTime        @default(now())
  accountId     String?
  fromAccountId String?
  toAccountId   String?
  categoryId    String?
  scheduledTransactionId String?       @map("scheduled_transaction_id")
  userId        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  account       Account?        @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Cascade)
  fromAccount   Account?        @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount     Account?        @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  scheduledTransaction ScheduledTransaction? @relation(fields: [scheduledTransactionId], references: [id], onDelete: SetNull)
  goalContribution GoalContribution?

  @@index([userId])
  @@index([scheduledTransactionId])
  @@index([fromAccountId])
  @@index([toAccountId])
}

model Goal {
  id            String    @id @default(uuid())
  type          GoalType  @default(SAVINGS)
  name          String
  targetAmount  Decimal   @db.Decimal(12, 2)
  currentAmount Decimal   @default(0) @db.Decimal(12, 2)
  targetDate    DateTime?
  accountId     String?
  userId        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account       Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contributions GoalContribution[]

  @@index([userId])
  @@index([accountId])
}

model GoalContribution {
  id            String      @id @default(uuid())
  goalId        String
  transactionId String      @unique
  createdAt     DateTime    @default(now())

  goal          Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([transactionId])
}

model ScheduledTransaction {
  id                    String                      @id @default(uuid())
  type                  TransactionType
  amount                Decimal                     @db.Decimal(12, 2)
  description           String?
  frequency             RecurringFrequency
  nextDueDate           DateTime
  notifyDaysBefore      Int?
  status                ScheduledTransactionStatus @default(ACTIVE)
  totalInstallments     Int?
  completedInstallments Int                         @default(0)
  accountId             String
  account               Account                     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId            String
  category              Category                    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  userId                String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  transactions          Transaction[]
  notifications         Notification[]

  @@map("scheduled_transactions")
  @@index([userId])
  @@index([nextDueDate])
  @@index([status])
}

model Budget {
  id         String   @id @default(uuid())
  amount     Decimal  @db.Decimal(12, 2)
  month      Int
  year       Int
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, month, year, userId])
  @@index([userId])
}

model ChatSession {
  id        String        @id @default(uuid())
  title     String?
  isActive  Boolean       @default(true)
  userId    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id         String      @id @default(uuid())
  role       String
  content    String
  toolCalls  String?
  toolCallId String?
  toolName   String?
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
}

model Notification {
  id                     String           @id @default(uuid())
  userId                 String
  scheduledTransactionId String?
  type                   NotificationType
  title                  String
  body                   String
  isRead                 Boolean          @default(false)
  readAt                 DateTime?
  createdAt              DateTime         @default(now())

  scheduledTransaction   ScheduledTransaction? @relation(fields: [scheduledTransactionId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

enum AccountType {
  CASH
  BANK
  EWALLET
  CREDIT_CARD
  LOAN
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum RecurringFrequency {
  ONCE
  WEEKLY
  MONTHLY
  YEARLY
}

enum ScheduledTransactionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum NotificationType {
  SCHEDULED_TX_DUE
}

enum GoalType {
  SAVINGS
  DEBT_PAYOFF
}
